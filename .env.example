# ── Supabase (server-side, used by SSR middleware) ──────────────────
SUPABASE_PUBLISHABLE_KEY=            # Supabase anon / public key
SUPABASE_URL=                        # e.g. https://<project-id>.supabase.co

# ── Supabase (client-side, VITE_ prefix exposes to browser) ────────
VITE_SUPABASE_PROJECT_ID=            # Supabase project ID (for OAuth redirect)
VITE_SUPABASE_PUBLISHABLE_KEY=       # Same anon key — safe for browser
VITE_SUPABASE_URL=                   # Same project URL

# ── Backend API ────────────────────────────────────────────────────
# In development the Vite dev server proxies /api/v1 to localhost:8000
# so this is only needed for production.
VITE_API_BASE_URL=                   # e.g. https://lockedin-api.onrender.com/api/v1

# ── Optional: CSRF cookie name override ────────────────────────────
# VITE_CSRF_COOKIE_NAME=lockedin_csrf_token
